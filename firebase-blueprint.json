{
  "entities": {
    "locations": {
      "title": "Location",
      "description": "Exploration destinations with photo galleries, ratings, and detailed attributes",
      "type": "document",
      "path": "locations/{locationId}",
      "fields": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "locationName": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "rating": { "type": "number", "description": "Average rating from 1 to 5" },
        "ratingSum": { "type": "number", "description": "Sum of all ratings" },
        "ratingCount": { "type": "number", "description": "Total number of user ratings submitted" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "circuits": {
      "title": "Circuit",
      "description": "Travel itineraries and circuits with stops and images",
      "type": "document",
      "path": "circuits/{circuitId}",
      "fields": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "duration": { "type": "string" },
        "badge": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "bestFor": { "type": "string" },
        "accessType": { "type": "string" }
      }
    },
    "userRatings": {
      "title": "User Rating",
      "description": "Individual ratings submitted by users for a location",
      "type": "document",
      "path": "locations/{locationId}/ratings/{ratingId}",
      "fields": {
        "rating": { "type": "number", "description": "Rating score between 1 and 5" },
        "comment": { "type": "string", "description": "Optional user feedback comment" },
        "createdAt": { "type": "string", "description": "Timestamp of rating submission" }
      }
    },
    "pendingPermits": {
      "title": "Pending Permit",
      "description": "Quick notes and pending permit requests",
      "type": "document",
      "path": "pendingPermits/{permitId}",
      "fields": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "status": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "settings": {
      "title": "Settings",
      "description": "Application settings including subdomain configuration",
      "type": "document",
      "path": "settings/{settingId}",
      "fields": {
        "subdomain": { "type": "string" },
        "fullUrl": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "subdomains": {
      "title": "Subdomains",
      "description": "Reserved subdomain names",
      "type": "document",
      "path": "subdomains/{subdomain}",
      "fields": {
        "subdomain": { "type": "string" }
      }
    },
    "tourismPosts": {
      "title": "Tourism Post (Legacy)",
      "description": "Legacy tourism posts collection",
      "type": "document",
      "path": "tourismPosts/{postId}",
      "fields": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "photo": { "type": "string" },
        "gallery": { "type": "array" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "tourism_posts": {
      "title": "Tourism Post",
      "description": "User-submitted tourism publications with photo gallery, category, location, and status",
      "type": "document",
      "path": "tourism_posts/{postId}",
      "fields": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "author": { "type": "string" },
        "authorId": { "type": "string" },
        "authorEmail": { "type": "string" },
        "photo": { "type": "string" },
        "gallery": { "type": "array" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "description": "pending, validated, or rejected" },
        "rejectionReason": { "type": "string" },
        "contactPhone": { "type": "string" },
        "priceRange": { "type": "string" },
        "reportsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "validatedAt": { "type": "string" }
      }
    },
    "reports": {
      "title": "Report",
      "description": "Community reports for inappropriate tourism publications",
      "type": "document",
      "path": "reports/{reportId}",
      "fields": {
        "postId": { "type": "string" },
        "postTitle": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "reporterId": { "type": "string" },
        "status": { "type": "string", "description": "pending or resolved" },
        "createdAt": { "type": "string" }
      }
    },
    "users": {
      "title": "User Profile",
      "description": "Authenticated user profiles with roles (user or admin)",
      "type": "document",
      "path": "users/{userId}",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "description": "user or admin" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
