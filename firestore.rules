rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin") ||
        (request.auth.token.email != null && 
         request.auth.token.email == "elpubliologuenathan@gmail.com")
      );
    }

    // Collection des publications touristiques (tourism_posts)
    match /tourism_posts/{postId} {
      // Lecture publique uniquement si validée, ou si l'utilisateur est l'auteur, ou admin
      allow read: if resource.data.status == "validated" || 
                     resource.data.status == "VALIDATED" ||
                     (isSignedIn() && resource.data.authorId == request.auth.uid) ||
                     isAdmin();

      // Création : utilisateur connecté, status forcé à "pending", authorId = son uid
      allow create: if isSignedIn() &&
                       request.resource.data.authorId == request.auth.uid &&
                       (request.resource.data.status == "pending" || request.resource.data.status == "PENDING");

      // Modification du statut et suppression : admin uniquement. L'auteur peut modifier son brouillon en attente
      allow update: if isAdmin() || 
                       (isSignedIn() && 
                        resource.data.authorId == request.auth.uid && 
                        request.resource.data.authorId == request.auth.uid &&
                        resource.data.status == "pending" &&
                        request.resource.data.status == "pending");

      allow delete: if isAdmin();
    }

    // Support de rétrocompatibilité pour tourismPosts
    match /tourismPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collection des signalements (reports)
    match /reports/{reportId} {
      // Tout visiteur peut signaler, mais uniquement avec les champs attendus,
      // un statut "pending" et des textes de taille raisonnable
      allow create: if request.resource.data.status == "pending" &&
                       request.resource.data.keys().hasOnly([
                         'postId', 'postTitle', 'postCategory', 'postLocation',
                         'reason', 'details', 'reportedBy', 'reportedByEmail',
                         'reportedAt', 'status'
                       ]) &&
                       (!('details' in request.resource.data) ||
                        (request.resource.data.details is string && request.resource.data.details.size() <= 1000)) &&
                       request.resource.data.reason is string &&
                       request.resource.data.reason.size() <= 200;
      allow read, update, delete: if isAdmin();
    }

    // Profils utilisateurs (users)
    match /users/{userId} {
      // Chacun lit son propre profil ; l'admin lit tous les profils
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Création : son propre profil, avec le rôle "user" (sauf le compte admin principal)
      allow create: if isSignedIn() && request.auth.uid == userId && (
        request.resource.data.role == "user" ||
        request.auth.token.email == "elpubliologuenathan@gmail.com"
      ) || isAdmin();

      // Mise à jour : son propre profil sans toucher au rôle, ou admin
      allow update: if isSignedIn() && request.auth.uid == userId &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // Collections Kongo Explorer de base : lecture publique, écriture admin uniquement
    match /locations/{locationId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      // Les visiteurs ne peuvent que mettre à jour la note moyenne d'une destination
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'ratingCount', 'ratingSum', 'updatedAt']) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 0 && request.resource.data.rating <= 5
      );

      match /ratings/{ratingId} {
        allow read: if true;
        // Un avis : note de 1 à 5 et commentaire limité à 1000 caractères
        allow create: if request.resource.data.rating is int &&
                         request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                         request.resource.data.comment is string &&
                         request.resource.data.comment.size() <= 1000;
        allow update, delete: if isAdmin();
      }
    }

    match /circuits/{circuitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notes rapides des visiteurs (Quick Capture) : validation stricte anti-spam
    // Clés limitées, statut initial PENDING ou VERIFICATION, tailles de champs maîtrisées
    match /pendingPermits/{permitId} {
      allow read: if true;
      allow create: if (
        request.resource.data.keys().hasAll(['id', 'title', 'subtitle', 'status', 'icon']) &&
        request.resource.data.keys().hasOnly(['id', 'title', 'subtitle', 'status', 'icon']) &&
        request.resource.data.status in ['PENDING', 'VERIFICATION'] &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150 &&
        request.resource.data.subtitle is string && request.resource.data.subtitle.size() <= 500 &&
        request.resource.data.icon is string && request.resource.data.icon.size() <= 50 &&
        request.resource.data.id is string && request.resource.data.id.size() <= 100
      ) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /subdomains/{subdomain} {
      allow read, write: if isAdmin();
    }
  }
}
